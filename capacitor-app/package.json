{
  "name": "7xcinema-capacitor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "7xCinema React + Capacitor application",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "android:init": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@capacitor/app": "8.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "@capacitor/cli": "8.6.0"
  }
}
