# Optional public TMDB v3 API key for CI/build-time live catalogue.
# Client-side values are bundled into the app; never put server secrets here.
VITE_TMDB_API_KEY=

# Optional local backend for browser development only. Android starts its bundled
# MovieBox-TUI engine itself and uses an ephemeral in-memory token.
# VITE_ values are bundled into client code; never put a production/remote secret here.
VITE_MOVIEBOX_TUI_BASE_URL=
VITE_MOVIEBOX_TUI_TOKEN=
